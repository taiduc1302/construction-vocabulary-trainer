{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Construction Vocabulary Term",
  "type": "object",
  "required": ["id","term","category","definition_en","explanation_ru","translation_ru","translation_vi","example_en","scenario","visual","related_terms","difficulty"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "term": {"type":"string","minLength":1},
    "pronunciation": {"type":"string"},
    "category": {"type":"string"},
    "definition_en": {"type":"string","minLength":10},
    "explanation_ru": {"type":"string","minLength":10},
    "translation_ru": {"type":"array","minItems":1,"items":{"type":"string"}},
    "translation_vi": {"type":"array","minItems":1,"items":{"type":"string"}},
    "example_en": {"type":"string","minLength":10},
    "scenario": {"type":"string","minLength":10},
    "visual": {"type":"string","minLength":10},
    "related_terms": {"type":"array","items":{"type":"string"}},
    "common_mistakes": {"type":"array","items":{"type":"string"}},
    "difficulty": {"type":"integer","minimum":1,"maximum":5}
  },
  "additionalProperties": true
}
